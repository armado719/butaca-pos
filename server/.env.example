# .env.example — copiá este archivo como .env y completá los valores

# Puerto del servidor
PORT=3001

# Entorno: development | production
NODE_ENV=development

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=butaca_pos

# JWT — OBLIGATORIO: genera un valor aleatorio seguro, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# URL del frontend (usada para CORS en HTTP y Socket.io)
# Para múltiples orígenes separalos con coma: http://localhost:5173,https://tudominio.com
FRONTEND_URL=http://localhost:5173

# Nivel de logging: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info
